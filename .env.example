# Copy this file to .env and fill in your own key. NEVER commit .env.
# Get a key at https://coinmarketcap.com/api — hackathon participants are
# upgraded to the free Startup tier for the event window (see README).

# live  = call the real CoinMarketCap API (requires CMC_API_KEY)
# mock  = use the cached fixture responses in src/fixtures.mjs (no key needed)
# Leave unset: live when a key is present, mock otherwise.
CMC_MODE=

# Your CoinMarketCap Pro API key (sent as the X-CMC_PRO_API_KEY header).
CMC_API_KEY=<redacted>

# Optional overrides.
CMC_API_BASE_URL=https://pro-api.coinmarketcap.com
RECEIPTS_FILE=data/receipts.jsonl
